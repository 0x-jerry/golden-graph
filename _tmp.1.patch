+import type { INodeDefinition } from '@0x-jerry/golden-graph-backend'
+import { defineTslNode, param } from './define'
+
+function binary(
+  name: string,
+  description: string,
+  tsName: string,
+): INodeDefinition {
+  return defineTslNode({
+    name,
+    description,
+    params: [param('a', 'A'), param('b', 'B')],
+    build: ({ a, b }) => `${tsName}(${a}, ${b})`,
+  })
+}
+
+function unary(
+  name: string,
+  description: string,
+  tsName: string,
+): INodeDefinition {
+  return defineTslNode({
+    name,
+    description,
+    params: [param('x', 'X')],
+    build: ({ x }) => `${tsName}(${x})`,
+  })
+}
